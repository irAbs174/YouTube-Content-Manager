# Copy to backend/.env (or export the variables) — every value is optional;
# the defaults run a zero-config local stack on SQLite.

# Postgres in production / Docker Compose; SQLite fallback otherwise.
# YTCM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_db

# Where rendered videos + thumbnails are written.
# YTCM_RENDER_ROOT=/var/lib/ytcm/renders

# Seed deterministic sample data when the database is empty (default: true).
# YTCM_SEED_ON_STARTUP=true

# Browser origins allowed to call the API directly (comma-separated JSON array).
# YTCM_CORS_ORIGINS=["http://localhost:3000"]
