# YouTube Content Manager — backend environment
# Copy to .env and adjust for local dev or production.

# Database: postgres or sqlite fallback (default data/youtube.db)
YTCM_DATABASE_URL=sqlite:///./data/youtube.db
# Alternative: YTCM_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ytcm

# Render storage root
YTCM_RENDER_ROOT=./data/renders

# Auth — change in production!
YTCM_SESSION_SECRET=dev-insecure-change-me
YTCM_SESSION_TTL_DAYS=14
YTCM_DEMO_EMAIL=demo@ytcm.test
YTCM_DEMO_PASSWORD=demo-password-1

# CORS
YTCM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Seed / tables
YTCM_SEED_ON_STARTUP=true
YTCM_CREATE_TABLES_ON_STARTUP=true
